{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/punix81/OpenCode-Buddy/protocol/schemas/protocol-v1.schema.json",
  "title": "OpenCode Buddy protocol v1",
  "description": "One JSON object per line. Envelope-level unknown fields are ignored; data-level unknown fields are rejected.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/config" },
    { "$ref": "#/$defs/state" },
    { "$ref": "#/$defs/mcp_status" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/interaction" },
    { "$ref": "#/$defs/resync" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "status": {
      "type": "string",
      "enum": [
        "offline",
        "idle",
        "thinking",
        "generating",
        "working",
        "permission_required",
        "user_input_required",
        "success",
        "error",
        "compacting",
        "retrying",
        "interrupted"
      ]
    },
    "mcpStatus": {
      "type": "string",
      "enum": ["connected", "pending", "disabled", "failed", "needs_auth"]
    },
    "source": {
      "type": "string",
      "enum": ["live", "mock"]
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "E_PARSE",
        "E_TOO_LONG",
        "E_UNKNOWN_TYPE",
        "E_VERSION",
        "E_BOUNDS",
        "E_SERIAL",
        "E_INTERNAL"
      ]
    },
    "shortString": {
      "type": "string",
      "maxLength": 40
    },
    "nullableString": {
      "oneOf": [
        { "type": "string", "maxLength": 40 },
        { "type": "null" }
      ]
    },
    "uint32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "nullableUint32": {
      "oneOf": [
        { "$ref": "#/$defs/uint32" },
        { "type": "null" }
      ]
    },
    "hello": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "hello" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "fw", "proto", "maxLine", "boot"],
          "properties": {
            "device": { "const": "opencode-buddy" },
            "fw": { "type": "string", "maxLength": 16 },
            "proto": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": { "type": "integer", "minimum": 1, "maximum": 255 }
            },
            "maxLine": { "type": "integer", "minimum": 256, "maximum": 2048 },
            "boot": { "$ref": "#/$defs/uint32" }
          }
        }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "ready" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bridge", "proto", "run"],
          "properties": {
            "bridge": { "type": "string", "maxLength": 16 },
            "proto": { "type": "integer", "minimum": 1, "maximum": 255 },
            "run": { "type": "string", "pattern": "^[0-9a-f]{1,8}$" }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "config" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["autoReturnSeconds", "gestures", "source"],
          "properties": {
            "language": { "enum": ["en", "fr", "de"] },
            "quietMode": { "type": "boolean" },
            "autoReturnSeconds": { "type": "integer", "minimum": 10, "maximum": 600 },
            "gestures": {
              "type": "object",
              "additionalProperties": false,
              "required": ["debounceMs", "doublePressWindowMs", "longPressMs", "veryLongPressMs"],
              "properties": {
                "debounceMs": { "type": "integer", "minimum": 10, "maximum": 200 },
                "doublePressWindowMs": { "type": "integer", "minimum": 150, "maximum": 800 },
                "longPressMs": { "type": "integer", "minimum": 800, "maximum": 3000 },
                "veryLongPressMs": { "type": "integer", "minimum": 3000, "maximum": 10000 }
              }
            },
            "source": { "$ref": "#/$defs/source" }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "state" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "activeSessions", "connection", "versions", "source"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "model": { "$ref": "#/$defs/nullableString" },
            "agent": { "$ref": "#/$defs/nullableString" },
            "activeSessions": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "elapsedSeconds": { "$ref": "#/$defs/uint32" },
            "pendingPermissions": { "type": "integer", "minimum": 0, "maximum": 255 },
            "pendingQuestions": { "type": "integer", "minimum": 0, "maximum": 255 },
            "notifications": { "type": "integer", "minimum": 0, "maximum": 99 },
            "tokens": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input": { "$ref": "#/$defs/nullableUint32" },
                "output": { "$ref": "#/$defs/nullableUint32" },
                "total": { "$ref": "#/$defs/nullableUint32" },
                "contextPct": {
                  "oneOf": [
                    { "type": "number", "minimum": 0, "maximum": 100 },
                    { "type": "null" }
                  ]
                }
              }
            },
            "tools": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "success": { "$ref": "#/$defs/uint32" },
                "failed": { "$ref": "#/$defs/uint32" },
                "running": { "type": "integer", "minimum": 0, "maximum": 255 },
                "categories": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "read": { "$ref": "#/$defs/uint32" },
                    "edit": { "$ref": "#/$defs/uint32" },
                    "shell": { "$ref": "#/$defs/uint32" },
                    "search": { "$ref": "#/$defs/uint32" },
                    "mcp": { "$ref": "#/$defs/uint32" },
                    "other": { "$ref": "#/$defs/uint32" }
                  }
                }
              }
            },
            "mcp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["online", "total"],
              "properties": {
                "online": { "type": "integer", "minimum": 0, "maximum": 255 },
                "total": { "type": "integer", "minimum": 0, "maximum": 255 }
              }
            },
            "connection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bridge", "opencode"],
              "properties": {
                "bridge": { "enum": ["ready", "degraded"] },
                "opencode": { "enum": ["connected", "offline", "unknown"] }
              }
            },
            "versions": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bridge", "protocol"],
              "properties": {
                "bridge": { "type": "string", "maxLength": 16 },
                "protocol": { "type": "integer", "minimum": 1, "maximum": 255 }
              }
            },
            "source": { "$ref": "#/$defs/source" },
            "diagnostic": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": { "$ref": "#/$defs/errorCode" }
              }
            }
          }
        }
      }
    },
    "mcp_status": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "mcp_status" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["online", "total", "servers", "source"],
          "properties": {
            "online": { "type": "integer", "minimum": 0, "maximum": 255 },
            "total": { "type": "integer", "minimum": 0, "maximum": 255 },
            "source": { "$ref": "#/$defs/source" },
            "servers": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["alias", "status"],
                "properties": {
                  "alias": { "type": "string", "maxLength": 12 },
                  "status": { "$ref": "#/$defs/mcpStatus" }
                }
              }
            }
          }
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "heartbeat" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": false
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "ack" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ack"],
          "properties": {
            "ack": { "$ref": "#/$defs/seq" },
            "warning": {
              "oneOf": [
                { "$ref": "#/$defs/errorCode" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "interaction" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gesture", "screen"],
          "properties": {
            "gesture": { "enum": ["short", "double", "long", "very_long"] },
            "screen": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        }
      }
    },
    "resync": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "resync" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": { "enum": ["seq_gap", "parse_error", "state_error", "boot"] },
            "expected": { "type": "integer", "minimum": 0 },
            "received": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "error" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "id": { "type": "string", "maxLength": 24 },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "fatal"],
          "properties": {
            "code": { "$ref": "#/$defs/errorCode" },
            "fatal": { "type": "boolean" },
            "detail": { "type": "string", "maxLength": 48 }
          }
        }
      }
    }
  }
}
