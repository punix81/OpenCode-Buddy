{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/punix81/OpenCode-Buddy/main/protocol/schemas/protocol-v1.schema.json",
  "title": "OpenCode Buddy USB protocol v1 (draft)",
  "description": "Draft contract for the NDJSON messages exchanged over USB CDC. Ratified in Phase 2.",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/config" },
    { "$ref": "#/$defs/state" },
    { "$ref": "#/$defs/mcp_status" },
    { "$ref": "#/$defs/heartbeat" },
    { "$ref": "#/$defs/ack" },
    { "$ref": "#/$defs/interaction" },
    { "$ref": "#/$defs/resync" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "seq": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
    "status": {
      "type": "string",
      "enum": [
        "offline",
        "idle",
        "thinking",
        "generating",
        "working",
        "permission_required",
        "user_input_required",
        "success",
        "error",
        "compacting",
        "retrying",
        "interrupted"
      ]
    },
    "mcpStatus": {
      "type": "string",
      "enum": ["connected", "pending", "disabled", "failed", "needs_auth"]
    },
    "shortString": { "type": "string", "maxLength": 40, "pattern": "^[^\\u0000-\\u001F]*$" },
    "hello": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "hello" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "fw", "proto"],
          "properties": {
            "device": { "type": "string", "maxLength": 24 },
            "fw": { "type": "string", "maxLength": 16 },
            "proto": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
            "maxLine": { "type": "integer", "minimum": 256, "maximum": 2048 }
          }
        }
      }
    },
    "ready": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "ready" },
        "seq": { "$ref": "#/$defs/seq" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bridge", "proto", "session"],
          "properties": {
            "bridge": { "type": "string", "maxLength": 16 },
            "proto": { "type": "integer", "minimum": 1 },
            "session": { "type": "string", "maxLength": 24 }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "config" },
        "seq": { "$ref": "#/$defs/seq" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "quietMode"],
          "properties": {
            "language": { "enum": ["en", "fr", "de"] },
            "quietMode": { "type": "boolean" },
            "autoReturnSeconds": { "type": "integer", "minimum": 10, "maximum": 600 },
            "gestures": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "debounceMs": { "type": "integer", "minimum": 10, "maximum": 200 },
                "doublePressWindowMs": { "type": "integer", "minimum": 150, "maximum": 800 },
                "longPressMs": { "type": "integer", "minimum": 800, "maximum": 3000 },
                "veryLongPressMs": { "type": "integer", "minimum": 3000, "maximum": 10000 }
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "state" },
        "seq": { "$ref": "#/$defs/seq" },
        "ts": { "type": "integer" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "activeSessions"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "model": { "oneOf": [{ "$ref": "#/$defs/shortString" }, { "type": "null" }] },
            "agent": { "oneOf": [{ "$ref": "#/$defs/shortString" }, { "type": "null" }] },
            "activeSessions": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "elapsedSeconds": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "pendingPermissions": { "type": "integer", "minimum": 0, "maximum": 255 },
            "pendingQuestions": { "type": "integer", "minimum": 0, "maximum": 255 },
            "notifications": { "type": "integer", "minimum": 0, "maximum": 99 },
            "tokens": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
                "output": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
                "total": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }] },
                "contextPct": {
                  "oneOf": [
                    { "type": "number", "minimum": 0, "maximum": 100 },
                    { "type": "null" }
                  ]
                }
              }
            },
            "tools": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "success": { "type": "integer", "minimum": 0 },
                "failed": { "type": "integer", "minimum": 0 },
                "running": { "type": "integer", "minimum": 0, "maximum": 255 },
                "categories": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "read": { "type": "integer", "minimum": 0 },
                    "edit": { "type": "integer", "minimum": 0 },
                    "shell": { "type": "integer", "minimum": 0 },
                    "search": { "type": "integer", "minimum": 0 },
                    "mcp": { "type": "integer", "minimum": 0 },
                    "other": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            },
            "mcp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "online": { "type": "integer", "minimum": 0, "maximum": 255 },
                "total": { "type": "integer", "minimum": 0, "maximum": 255 }
              }
            },
            "connection": {
              "type": "object",
              "additionalProperties": false,
              "required": ["usb", "bridge", "opencode"],
              "properties": {
                "usb": { "enum": ["connected", "disconnected"] },
                "bridge": { "enum": ["ready", "degraded"] },
                "opencode": { "enum": ["connected", "offline"] }
              }
            }
          }
        }
      }
    },
    "mcp_status": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "mcp_status" },
        "seq": { "$ref": "#/$defs/seq" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["online", "total", "servers"],
          "properties": {
            "online": { "type": "integer", "minimum": 0, "maximum": 255 },
            "total": { "type": "integer", "minimum": 0, "maximum": 255 },
            "servers": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["alias", "status"],
                "properties": {
                  "alias": { "type": "string", "maxLength": 20 },
                  "status": { "$ref": "#/$defs/mcpStatus" }
                }
              }
            }
          }
        }
      }
    },
    "heartbeat": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "heartbeat" },
        "seq": { "$ref": "#/$defs/seq" }
      }
    },
    "ack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "ack" },
        "seq": { "$ref": "#/$defs/seq" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ack"],
          "properties": {
            "ack": { "$ref": "#/$defs/seq" },
            "warning": { "oneOf": [{ "type": "string", "maxLength": 48 }, { "type": "null" }] }
          }
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "interaction" },
        "seq": { "$ref": "#/$defs/seq" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gesture", "screen"],
          "properties": {
            "gesture": { "enum": ["short", "double", "long", "very_long"] },
            "screen": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        }
      }
    },
    "resync": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "resync" },
        "seq": { "$ref": "#/$defs/seq" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": { "enum": ["seq_gap", "parse_error", "state_error", "boot"] },
            "expected": { "$ref": "#/$defs/seq" },
            "received": { "$ref": "#/$defs/seq" }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": true,
      "required": ["v", "type", "seq", "data"],
      "properties": {
        "v": { "const": 1 },
        "type": { "const": "error" },
        "seq": { "$ref": "#/$defs/seq" },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "fatal"],
          "properties": {
            "code": {
              "enum": [
                "E_PARSE",
                "E_TOO_LONG",
                "E_UNKNOWN_TYPE",
                "E_VERSION",
                "E_BOUNDS",
                "E_SERIAL",
                "E_INTERNAL"
              ]
            },
            "fatal": { "type": "boolean" },
            "detail": { "type": "string", "maxLength": 48 }
          }
        }
      }
    }
  }
}
